
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VocabularyStatus {
  NEW
  LEARNING
  FAMILIAR
  MASTERED
}

enum ReviewResult {
  CORRECT
  WRONG
  ALMOST
}

model Vocabulary {
  id              String           @id @default(cuid())

  japanese        String
  reading         String
  meaning         String
  explanation     String?

  exampleJapanese String?
  exampleEnglish  String?

  status          VocabularyStatus @default(NEW)

  correctCount    Int              @default(0)
  wrongCount      Int              @default(0)
  almostCount     Int              @default(0)

  streak          Int              @default(0)

  intervalDays    Int              @default(0)
  nextReviewAt    DateTime         @default(now())
  lastReviewedAt  DateTime?

  jlptLevel       String?
  tags            String[]         @default([])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reviews         Review[]

  @@index([status])
  @@index([nextReviewAt])
}

model Review {
  id           String       @id @default(cuid())
  vocabularyId String
  vocabulary   Vocabulary   @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  result       ReviewResult
  responseTime Int?
  reviewedAt   DateTime     @default(now())

  @@index([vocabularyId])
  @@index([reviewedAt])
}

model OAuthClient {
  clientId                String   @id
  clientName              String
  redirectUris            String[]
  grantTypes              String[]
  responseTypes           String[]
  tokenEndpointAuthMethod String   @default("none")
  createdAt               DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]
}

model OAuthAuthorizationCode {
  id                  String   @id @default(cuid())
  codeHash            String   @unique
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  resource            String
  scopes              String[] @default([])
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model OAuthAccessToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  familyId  String
  clientId  String
  resource  String
  scopes    String[] @default([])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([familyId])
}

model OAuthRefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  familyId   String
  clientId   String
  resource   String
  scopes     String[] @default([])
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([familyId])
  @@index([expiresAt])
}
